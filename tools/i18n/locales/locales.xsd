<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- 根节点定义 -->
    <xs:element name="locales">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="languages" type="languagesType" />
                <xs:element name="translates" type="translatesType" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 语言列表定义 -->
    <xs:complexType name="languagesType">
        <xs:sequence>
            <xs:element name="ja-JP" type="langMetaType" />
            <xs:sequence maxOccurs="unbounded">
                <xs:element name="en-US" type="langMetaDerivedType" minOccurs="0" />
                <xs:element name="zh-CN" type="langMetaDerivedType" minOccurs="0" />
                <xs:element name="zh-TW" type="langMetaDerivedType" minOccurs="0" />
                <xs:element name="zh-HK" type="langMetaDerivedType" minOccurs="0" />
                <xs:element name="ko-KR" type="langMetaDerivedType" minOccurs="0" />
            </xs:sequence>
        </xs:sequence>
    </xs:complexType>

    <!-- 原语言元数据 -->
    <xs:complexType name="langMetaType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" />
            <xs:element name="version" type="xs:string" />
            <xs:element name="contributors" type="contributorsType" />
        </xs:sequence>
    </xs:complexType>

    <!-- 派生语言元数据（带 source 属性） -->
    <xs:complexType name="langMetaDerivedType">
        <xs:complexContent>
            <xs:extension base="langMetaType">
                <xs:attribute name="source" type="xs:string" use="required" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- 贡献者列表 -->
    <xs:complexType name="contributorsType">
        <xs:sequence>
            <xs:element name="person" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:attribute name="name" type="xs:string" use="required" />
                    <xs:attribute name="type" type="xs:string" use="optional" />
                    <xs:attribute name="email" type="xs:string" use="optional" />
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- 扁平翻译列表 -->
    <xs:complexType name="translatesType">
        <xs:sequence>
            <xs:element name="translate" type="translateItemType" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- 单个翻译节点；结构与原 item 一致，但去掉路径/文件名以及内部 translate 包装节点 -->
    <xs:complexType name="translateItemType">
        <xs:sequence>
            <xs:element name="match" type="matchType" />
            <xs:element name="en-US" type="contentValueType" minOccurs="0" />
            <xs:element name="zh-CN" type="contentValueType" minOccurs="0" />
            <xs:element name="zh-TW" type="contentValueType" minOccurs="0" />
            <xs:element name="zh-HK" type="contentValueType" minOccurs="0" />
            <xs:element name="ko-KR" type="contentValueType" minOccurs="0" />
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>

    <!-- 匹配条件节点 -->
    <xs:complexType name="matchType">
        <xs:choice maxOccurs="unbounded">
            <xs:element name="text">
                <xs:complexType>
                    <xs:attribute name="content" type="xs:string" use="required" />
                </xs:complexType>
            </xs:element>
            <xs:element name="param">
                <xs:complexType>
                    <xs:attribute name="name" type="xs:string" use="required" />
                </xs:complexType>
            </xs:element>
        </xs:choice>
        <xs:attribute name="type" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="equals" />
                    <xs:enumeration value="contains" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <!-- 翻译文本属性节点 -->
    <xs:complexType name="contentValueType">
        <xs:attribute name="content" type="xs:string" use="required" />
    </xs:complexType>

</xs:schema>
