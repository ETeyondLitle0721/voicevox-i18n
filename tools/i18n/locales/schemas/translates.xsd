<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- 根节点定义 -->
    <xs:element name="translates" type="translatesType" />

    <!-- 翻译列表容器 -->
    <xs:complexType name="translatesType">
        <xs:sequence>
            <xs:element name="item" type="itemType" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- 单个 item 节点定义：包含 match 与 translate 包裹节点 -->
    <xs:complexType name="itemType">
        <xs:sequence>
            <xs:element name="match" type="matchType" />
            <xs:element name="translate" type="translateWrapperType" />
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>

    <!-- 翻译语言包裹节点类型 -->
    <xs:complexType name="translateWrapperType">
        <xs:sequence>
            <xs:element name="en-US" type="contentValueType" minOccurs="0" />
            <xs:element name="zh-CN" type="contentValueType" minOccurs="0" />
            <xs:element name="zh-TW" type="contentValueType" minOccurs="0" />
            <xs:element name="zh-HK" type="contentValueType" minOccurs="0" />
            <xs:element name="ko-KR" type="contentValueType" minOccurs="0" />
            <xs:element name="vi-VN" type="contentValueType" minOccurs="0" />
            <xs:element name="th-TH" type="contentValueType" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>

    <!-- 匹配条件节点 -->
    <xs:complexType name="matchType">
        <xs:choice maxOccurs="unbounded">
            <xs:element name="text">
                <xs:complexType>
                    <xs:attribute name="content" type="xs:string" use="required" />
                </xs:complexType>
            </xs:element>
            <xs:element name="param">
                <xs:complexType>
                    <xs:attribute name="name" type="xs:string" use="required" />
                    <xs:attribute name="translate" default="disallow" use="optional">
                        <xs:annotation>
                            <xs:documentation>When set to allow, the captured parameter can be referenced by [0] / [1] style placeholders after a second-pass translation; {0} / {1} keep the original capture.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="allow" />
                                <xs:enumeration value="disallow" />
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
        </xs:choice>
        <xs:attribute name="type" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="equals" />
                    <xs:enumeration value="contains" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <!-- 翻译文本属性节点 -->
    <xs:complexType name="contentValueType">
        <xs:attribute name="content" type="xs:string" use="required" />
    </xs:complexType>

</xs:schema>